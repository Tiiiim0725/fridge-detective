    {
      "recipeKey": "tomato_egg_stir_fry",
      "zhName": "番茄炒蛋",
      "needsReview": false,
      "recipeSteps": [
        {
          "stepNumber": 1,
          "title": "处理食材",
          "body": "番茄切成小块，鸡蛋打散，葱花备好，番茄块大小尽量接近。",
          "estimatedMinutes": 4,
          "timerSeconds": null,
          "ingredientKeys": ["tomato", "egg", "scallion"],
          "equipmentKeys": ["knife", "cutting_board", "bowl"]
        },
        {
          "stepNumber": 2,
          "title": "先炒鸡蛋",
          "body": "热锅加油后倒入蛋液，推成柔软蛋块，表面刚凝固时盛出。",
          "estimatedMinutes": 3,
          "timerSeconds": null,
          "ingredientKeys": ["egg"],
          "equipmentKeys": ["stove_or_hotplate", "frying_pan_or_wok", "spatula"]
        },
        {
          "stepNumber": 3,
          "title": "炒软番茄",
          "body": "锅中补少量油，下番茄翻炒，边缘变软并有少量汁水时调味。",
          "estimatedMinutes": 5,
          "timerSeconds": null,
          "ingredientKeys": ["tomato"],
          "equipmentKeys": ["stove_or_hotplate", "frying_pan_or_wok", "spatula"]
        },
        {
          "stepNumber": 4,
          "title": "合炒装盘",
          "body": "倒回鸡蛋轻轻翻匀，蛋块裹到番茄汁后撒葱花，盛出即可。",
          "estimatedMinutes": 3,
          "timerSeconds": null,
          "ingredientKeys": ["tomato", "egg", "scallion"],
          "equipmentKeys": ["frying_pan_or_wok", "spatula", "plate"]
        }
      ],
      "tutorialSteps": [
        {
          "stepNumber": 1,
          "title": "切配番茄",
          "body": "番茄去蒂后切成小块，尽量大小接近，看到果肉和汁水都集中在案板上即可。",
          "actionKey": "slice_vegetables",
          "ingredientKeys": ["tomato"],
          "equipmentKeys": ["knife", "cutting_board"],
          "estimatedMinutes": 3,
          "timerSeconds": null,
          "assistantContext": "可提醒用户番茄不必去皮；如果喜欢更多汤汁，可以切得稍小。"
        },
        {
          "stepNumber": 2,
          "title": "打散鸡蛋",
          "body": "鸡蛋打入碗中搅到蛋清蛋黄融合，筷子提起时没有明显透明蛋清即可。",
          "actionKey": "beat_eggs",
          "ingredientKeys": ["egg"],
          "equipmentKeys": ["bowl", "chopsticks_or_fork"],
          "estimatedMinutes": 2,
          "timerSeconds": null,
          "assistantContext": "可建议加一小撮盐帮助底味，但不强制。"
        },
        {
          "stepNumber": 3,
          "title": "炒出蛋块",
          "body": "锅热后加油倒入蛋液，用锅铲轻推成大块，表面刚凝固且仍柔软时盛出。",
          "actionKey": "scramble_eggs",
          "ingredientKeys": ["egg"],
          "equipmentKeys": ["stove_or_hotplate", "frying_pan_or_wok", "spatula"],
          "estimatedMinutes": 3,
          "timerSeconds": null,
          "assistantContext": "如果蛋块过碎，提醒下次减少翻动；如果锅太干可补少量油。"
        },
        {
          "stepNumber": 4,
          "title": "炒软番茄",
          "body": "锅中下番茄翻炒，看到边缘变软、锅底出现橙红汁水时再进入调味。",
          "actionKey": "stir_fry",
          "ingredientKeys": ["tomato"],
          "equipmentKeys": ["stove_or_hotplate", "frying_pan_or_wok", "spatula"],
          "estimatedMinutes": 4,
          "timerSeconds": null,
          "assistantContext": "番茄较硬时可加一两勺水帮助出汁。"
        },
        {
          "stepNumber": 5,
          "title": "合炒调味",
          "body": "把鸡蛋倒回锅中，加盐轻轻翻匀，蛋块裹上番茄汁但没有被压碎即可。",
          "actionKey": "combine_ingredients",
          "ingredientKeys": ["tomato", "egg"],
          "equipmentKeys": ["frying_pan_or_wok", "spatula"],
          "estimatedMinutes": 2,
          "timerSeconds": null,
          "assistantContext": "可根据酸度建议少量糖，但不默认要求。"
        },
        {
          "stepNumber": 6,
          "title": "装盘检查",
          "body": "撒葱花后盛出，观察蛋块柔软、番茄有汁但不水汪汪，就是适合出锅的状态。",
          "actionKey": "plate_dish",
          "ingredientKeys": ["tomato", "egg", "scallion"],
          "equipmentKeys": ["plate", "spatula"],
          "estimatedMinutes": 1,
          "timerSeconds": null,
          "assistantContext": "可提示用户如果汤汁太多，出锅前大火轻收十几秒。"
        }
      ]
    },
